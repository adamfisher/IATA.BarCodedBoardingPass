<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>IATA.BarCodedBoardingPass</PackageId>
    <Version>2016.06.07</Version>
    <Authors>Adam Fisher</Authors>
    <Description>A parser for International Air Transport Association (IATA) barcodes from a passenger boarding pass.</Description>
    <PackageProjectUrl>https://github.com/adamfisher/IATA.BarCodedBoardingPass</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adamfisher/IATA.BarCodedBoardingPass</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>iata_logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>iata;iata boarding pass;bcbp;boarding pass</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Legacy IataData members are undocumented; remove once they are. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="iata_logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
